#!/bin/sh
# mdv – otevře Markdown soubory v MDView.
#
#   mdv soubor.md [další.md …]   otevře soubory (relativní cesty vůči aktuálnímu adresáři)
#   mdv .                        otevře složku jako pracovní prostor (strom .md souborů)
#   mdv plan.md                  soubor ještě neexistuje → počká, až ho agent vytvoří (Ctrl+C ukončí)
#   mdv -g soubor.md             otevře na pozadí, terminál si nechá fokus
#   příkaz | mdv -               uloží stdin do dočasného .md a otevře ho
#   mdv                          spustí MDView
#   mdv --version                vypíše verzi nainstalované aplikace
#
# Skript leží v MDView.app/Contents/Resources/bin a aplikaci hledá podle sebe,
# aby `open -a MDView` nechytil jinou kopii (např. z DerivedData).

set -eu

SELF=$(readlink -f "$0")
case "$SELF" in
    */Contents/Resources/bin/*) APP=${SELF%/Contents/Resources/bin/*} ;;
    *) APP=/Applications/MDView.app ;;
esac
APP=${MDV_APP:-$APP}
OPEN=${MDV_OPEN:-open}

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    echo "MDView $(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP/Contents/Info.plist" 2>/dev/null || echo '?')"
    exit 0
fi

BACKGROUND=""
if [ "${1:-}" = "-g" ]; then
    BACKGROUND="-g"
    shift
fi

if [ $# -eq 0 ]; then
    exec $OPEN $BACKGROUND -a "$APP"
fi

for arg in "$@"; do
    if [ "$arg" = "-" ]; then
        tmp=$(mktemp "${TMPDIR:-/tmp}/mdv-stdin.XXXXXX")
        mv "$tmp" "$tmp.md"
        cat > "$tmp.md"
        set -- "$@" "$tmp.md"
    elif [ ! -e "$arg" ]; then
        # Agent soubor teprve vytvoří – počkat (nadřazená složka musí existovat).
        if [ ! -d "$(dirname "$arg")" ]; then
            echo "mdv: složka neexistuje: $(dirname "$arg")" >&2
            exit 1
        fi
        echo "mdv: čekám, až vznikne $arg (Ctrl+C ukončí)…" >&2
        while [ ! -e "$arg" ]; do
            sleep 0.3
        done
    fi
done

# Argument „-“ nahradil dočasný soubor připojený na konec; samotné „-“ vynecháme.
files=""
for arg in "$@"; do
    [ "$arg" = "-" ] && continue
    files="$files
$arg"
done

printf '%s\n' "$files" | sed '/^$/d' | while IFS= read -r file; do
    $OPEN $BACKGROUND -a "$APP" "$file"
done
