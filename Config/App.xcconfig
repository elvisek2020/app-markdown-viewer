// Aplikace MDView.
#include "Signing.xcconfig"

PRODUCT_NAME = MDView
PRODUCT_BUNDLE_IDENTIFIER = cz.elvisek.mdview
INFOPLIST_FILE = App/Info.plist
GENERATE_INFOPLIST_FILE = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
COMBINE_HIDPI_IMAGES = YES

// Vše v aplikaci běží na hlavním vlákně, pokud není řečeno jinak (Xcode 26+).
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// Bez App Sandboxu (osobní nástroj, sleduje libovolné cesty); hardened runtime ano.
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO

// Ikona aplikace (App/Assets.xcassets, generuje scripts/make-icon.swift).
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
